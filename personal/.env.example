# Owner identity: used by the outbound guard (these are the only people it may contact on its own)
PERSONAL_OWNER_EMAILS=you@example.com
PERSONAL_OWNER_TARGETS=+15550001111      # your WhatsApp number, E.164

# Google (Gmail, Calendar, Tasks): OAuth client + refresh token with these scopes:
#   gmail.modify, calendar, tasks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Resend (emails to you: briefs, alerts, digests)
RESEND_API_KEY=
RESEND_FROM="Assistant <assistant@yourdomain.com>"

# Dev analytics: comma-separated local repo paths to learn your pace from
PERSONAL_DEV_REPOS=/home/you/code/app,/home/you/code/site

# Optional: require /approve even for owner-requested sends to other people
# PERSONAL_CONFIRM_OUTBOUND=1
